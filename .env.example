# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/fos"

# Payload CMS
PAYLOAD_SECRET="generate-a-secure-random-string"

# Stripe
STRIPE_API_KEY="sk_test_..." # Secret key (server-side only)
NEXT_PUBLIC_STRIPE_KEY="pk_test_..." # Publishable key (client-side)
STRIPE_WEBHOOKS_ENDPOINT_SECRET="whsec_..." # Webhook signing secret

# S3 Storage (Railway Bucket)
S3_ENDPOINT="https://t3.storageapi.dev"
S3_BUCKET="your-bucket-name"
S3_REGION="auto"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"

# Email (Resend)
RESEND_API_KEY="re_..."
ADMIN_EMAIL="admin@example.com"

# App URLs
FRONTEND_URL="http://localhost:3000"


